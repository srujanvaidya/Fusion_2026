{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd dashboard && npm ci",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "site",
  "redirects": [
    { "source": "/get-started", "destination": "/get-started.html", "permanent": false },
    { "source": "/login", "destination": "/login.html", "permanent": false },
    { "source": "/dashboard", "destination": "/dashboard/dist/", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/dashboard/dist/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
