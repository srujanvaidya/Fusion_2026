# Set in Vercel Project → Settings → Environment Variables (Production / Preview)
# Rebuild after changing. Used at `npm run build` time in `dashboard/`.

# Public HTTPS URL of your GEE FastAPI service (no trailing slash). Example: https://skycrop-gee.vercel.app
# VITE_GEE_API_BASE=

# Optional Raya chat backend (see dashboard/src/services/rayaChatApi.js)
# VITE_CHAT_API_BASE=

# Raya assistant (language model). SERVER-SIDE ONLY: do not prefix with VITE_.
# Used by api/chat.js on Vercel, and by the dev server via dashboard/.env.local.
# GEMINI_API_KEY=
# (or ANTHROPIC_API_KEY=)
# RAYA_MODEL=claude-haiku-5-5
